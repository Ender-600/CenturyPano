# The demo provider is an offline engineering simulation, not AI reconstruction.
# To use GPT Image 2.5: set PROVIDER=openai and fill OPENAI_API_KEY, then restart.
PROVIDER=demo
PROVIDER_FALLBACK=fal
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_S=180
# Optional: Gemini provides scene understanding; fal provides image fallback.
GEMINI_API_KEY=
FAL_KEY=
K2_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
K2_MODEL=IFM/K2-Horizon-375B-A23B
K2_BASE_URL=https://api.ifm.ai/v1
FAL_MODEL=fal-ai/flux/dev/image-to-image
MAX_CONCURRENCY=6
# Independent 3D world probe; does not change the panorama image provider.
WORLDLAB_API_KEY=
# Optional absolute paths; defaults are data/in and data/out.
# IN_DIR=
# OUT_DIR=
