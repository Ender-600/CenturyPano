# The demo provider is an offline engineering simulation, not AI reconstruction.
# Switch to openai / gemini / grok / qwen after providing the corresponding key.
PROVIDER=demo
PROVIDER_FALLBACK=fal
GEMINI_API_KEY=
XAI_API_KEY=
FAL_KEY=
K2_API_KEY=
OPENAI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-3.6-flash
GROK_IMAGE_MODEL=grok-imagine-image-2.0
K2_MODEL=IFM/K2-Horizon-375B-A23B
K2_BASE_URL=https://api.ifm.ai/v1
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_S=180
OPENAI_TEXT_MODEL=gpt-4o-mini
FAL_MODEL=fal-ai/flux/dev/image-to-image
MAX_CONCURRENCY=6
# Optional absolute paths; defaults are data/in and data/out.
# IN_DIR=
# OUT_DIR=

# Independent Street View and immersive world generation.
WORLDLAB_API_KEY=
# Full 2:1 Street View edits require a model supporting custom panorama dimensions.
WORLD_OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
GOOGLE_MAPS_API_KEY=
# Enable only with Google permission covering storage and external AI generation.
# A normal Maps display API key alone does not grant that permission.
GOOGLE_STREETVIEW_AI_AUTHORIZED=false
# Optional application access code for remote world generation.
WORLD_ACCESS_TOKEN=
# WORLD_DIR=/absolute/path/to/private/worlds

# Allow historically justified building changes while fixing the camera/projection.
# Set to 1 only to opt into the legacy pixel/structure lock.
STRUCTURE_LOCK=0
